{
  "name": "@toyam/pipeline",
  "private": true,
  "type": "module",
  "description": "Processing pipeline worker (M6, D34-D38): job polling, PDF text, vision labels with escalation, OCR (pluggable, PaddleOCR sidecar), field value rules. One always-on container.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main.ts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-reporter=spec \"test/*.test.ts\"",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-reporter=spec \"test/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "pdfjs-dist": "6.5.438",
    "sharp": "^0.35.0"
  }
}
