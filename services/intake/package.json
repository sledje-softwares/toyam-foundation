{
  "name": "@toyam/intake",
  "private": true,
  "type": "module",
  "description": "Email intake: Gmail IMAP relay (Cloudflare Worker), template loader, parser tests. The parser itself lives in supabase/functions/_shared/intake.",
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-reporter=spec \"test/*.test.ts\"",
    "templates:json": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-templates.ts --dry-run",
    "templates:load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-templates.ts",
    "seed:templates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-template-seed.ts",
    "seed:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-template-seed.ts --check",
    "worker:dev": "npx wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/pdfmake": "0.3.3",
    "pdfmake": "0.3.13",
    "postal-mime": "^4.2.1",
    "yaml": "^2.9.1"
  }
}
