# Local Supabase defaults (supabase start). Use the anon / publishable key only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# How field operators sign in (same value as the admin-users secret FIELD_SIGN_IN):
# mobile_password (default, local seed) | email_password (hosted) | mobile_otp
NEXT_PUBLIC_FIELD_SIGN_IN=mobile_password
